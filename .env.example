# Required for LLM-backed planning/synthesis. Without this, MarketScout falls
# back to deterministic templates for planning and synthesis (still fully
# functional and testable, just less fluent prose).
GROQ_API_KEY=

# Optional model override. Defaults to a fast Groq-hosted Llama model.
MARKETSCOUT_MODEL=llama-3.3-70b-versatile

# Optional. Without this, web_search/web_fetch use offline fixture data
# (Stripe/Adyen/Paddle/Braintree) so the agent runs with zero external keys.
TAVILY_API_KEY=

MAX_SEARCH_RETRIES=2
MAX_FETCH_RETRIES=2
HTTP_TIMEOUT_SECONDS=15

# none | malformed_search_response | fetch_timeout | rate_limit
FAILURE_INJECTION_MODE=none
